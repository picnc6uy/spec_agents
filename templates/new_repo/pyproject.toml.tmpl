[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "@@NAME@@"
version = "0.1.0"
description = "@@NAME@@ (new stack repo; replace this line)."
requires-python = ">=3.12"
dependencies = [
    # Shared agent/adapter primitives, pinned to a release tag (stack rule XR-005).
    # For local dev, override in the venv: `pip install -e ../spec_agents`.
    "spec-agents @ git+https://github.com/picnc6uy/spec_agents@@@TAG@@",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0.0",
    "ruff==0.16.6",
    "pyright==1.1.411",  # stack-wide pin, so a local `.[dev]` matches CI.
]

[tool.hatch.metadata]
# Required for the `spec-agents @ git+https://...` direct reference above.
allow-direct-references = true

[tool.hatch.build.targets.wheel]
packages = ["src/@@PKG@@"]

[tool.pyright]
include = ["src"]
strict = []  # an array of paths, never a boolean.
pythonVersion = "3.12"

[tool.ruff]
line-length = 100
target-version = "py312"
# The Forge v2 kit is vendored byte-for-byte from ~/forge-v2; its own repo lints it.
extend-exclude = [".claude"]

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM"]
ignore = ["E501"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
